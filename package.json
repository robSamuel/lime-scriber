{
  "name": "lime-scriber",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @lime-scriber/api\" \"npm run dev -w @lime-scriber/web\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @lime-scriber/api",
    "db:seed": "npm run db:seed -w @lime-scriber/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
